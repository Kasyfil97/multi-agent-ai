# api configuration. Copy to .env (or set as real env vars).
# Reuses the same upstreams as the repo; NO Azure/evaluator vars (generate-only).

# --- service tuning ---
LOG_LEVEL=INFO
LOG_JSON=false
MAX_CONCURRENCY=4
BEDROCK_POOL_SIZE=4
PG_POOL_MIN=1
PG_POOL_MAX=8

# --- timeouts (seconds) ---
JOB_MAX_SECONDS=240          # wall-clock cap per request (runaway guard)
RETRIEVAL_TIMEOUT=45
PLAN_TIMEOUT=150
SQL_TIMEOUT=150
VALIDATE_TIMEOUT=20
RETRIES=2
BACKOFF_BASE=1.5

# --- retrieval ---
RETRIEVAL_K=5
CONF_THRESHOLD=38

# --- Bedrock / OIDC (gpt-oss-120b) ---
AWS_REGION=ap-southeast-3
BEDROCK_MODEL_ID=openai.gpt-oss-120b-1:0
BEDROCK_READ_TIMEOUT=140
BEDROCK_CONNECT_TIMEOUT=15
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AWS_ROLE_ARN_BRIDGE=
AWS_ROLE_ARN_TARGET=

# --- Postgres ---
PG_HOST=localhost
PG_PORT=5433
PG_DBNAME=postgres
PG_USER=postgres
PG_PASSWORD=postgres
PG_KB_SCHEMA=public

# --- embedding service (bge-m3) ---
EMBED_URL=http://localhost:8080/v1/embeddings
EMBED_TOKEN=
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
EMBED_TIMEOUT=30
